# Copy to .env (never commit .env). No secrets are required by ELEVENS.

# Game server (src/server)
PORT=8787
HOST=0.0.0.0
# Comma-separated list of allowed browser origins for WebSocket upgrades.
# Leave empty to allow any origin (fine for local play).
ALLOWED_ORIGINS=
# Serve the built client from dist/client on the same port (1 = yes).
SERVE_CLIENT=1
# Signs ranked records kept on players' devices (needed when the server has no lasting disk).
RANKED_SECRET=
# When SERVE_CLIENT=0, the server's own address redirects to the game here.
PLAY_URL=
# Testing aids: artificial one-way delay and jitter added to every message (ms).
SIM_LATENCY_MS=0
SIM_JITTER_MS=0

# Client build (Vite). Optional absolute WebSocket URL of a separately hosted
# server, e.g. wss://elevens-server.example.com/ws . When empty the client uses
# the page's own origin + /ws.
VITE_SERVER_URL=
