{
  "name": "elevens",
  "version": "0.1.0",
  "private": true,
  "description": "ELEVENS - an original browser-based 3D 11-a-side football game with offline AI and authoritative online exhibition matches.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/server/index.mjs",
    "start": "node dist/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx scripts/simulate.ts",
    "e2e": "node scripts/e2e.mjs",
    "e2e:features": "node scripts/e2e-features.mjs",
    "e2e:ideas": "node scripts/e2e-ideas.mjs",
    "e2e:more": "node scripts/e2e-more.mjs",
    "e2e:skills": "node scripts/e2e-skills.mjs",
    "e2e:polish": "node scripts/e2e-polish.mjs",
    "e2e:gameplay": "node scripts/e2e-gameplay5.mjs",
    "e2e:mates": "node scripts/e2e-teammates.mjs",
    "e2e:mates3": "node scripts/e2e-mates3.mjs",
    "e2e:mouse": "node scripts/e2e-mouse.mjs",
    "e2e:hints": "node scripts/e2e-hints.mjs",
    "e2e:menus": "node scripts/e2e-menus.mjs",
    "e2e:modes": "node scripts/e2e-modes19.mjs",
    "e2e:gameplay6": "node scripts/e2e-gameplay6.mjs",
    "e2e:hosted": "node scripts/e2e-hosted.mjs"
  },
  "dependencies": {
    "three": "0.186.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "jpeg-js": "^0.4.4",
    "playwright-core": "1.56.1",
    "pngjs": "^7.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
